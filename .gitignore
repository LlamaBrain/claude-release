# Build deps (top-level + any nested) — installed via `npm install` at repo root.
# Runtime deps for plugin/lib/ entry points are now bundled inline by scripts/bundle.mjs
# (esbuild), so plugin/lib/node_modules/ no longer needs to exist at consumer-install time.
node_modules/

# .NET build artifacts — produced on demand by api-diff.js
plugin/lib/dotnet/**/bin/
plugin/lib/dotnet/**/obj/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Local consumer config (not yet implemented; reserved)
.claude-release.local.json

# Promptbook setup banner (occasionally created via shell redirection; not part of the project)
CON
